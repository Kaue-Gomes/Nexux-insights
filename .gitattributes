# Normaliza fim de linha como LF no repositório (evita ruído de CRLF no Windows)
* text=auto eol=lf

# Arquivos binários: nunca aplicar normalização de texto
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
